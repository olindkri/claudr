#!/usr/bin/env bash
# claudr — launch Claude Code routed through OpenRouter,
# with a model picker driven by OpenRouter's live programming leaderboard
# (https://openrouter.ai/rankings/programming).
#
# Usage:
#   claudr                       # interactive picker (top N from leaderboard)
#   claudr -m kimi               # short alias
#   claudr -m moonshotai/kimi-k2.6
#   claudr --list                # print top N, exit
#   claudr --list -n 50          # top 50
#   claudr --view month          # ranking window: day|week|month|trending
#   claudr --refresh             # bypass 6h cache
#   claudr -- <claude args...>   # forward flags to claude
#
# Key resolution order:
#   1. $OPENROUTER_API_KEY env var
#   2. ~/.config/claudr/key  (chmod 600)

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claudr"
KEY_FILE="$CONFIG_DIR/key"
RANK_CACHE="$CONFIG_DIR/rankings.tsv"
MODELS_CACHE="$CONFIG_DIR/models.json"

# --- key prompt/save: factored so the picker can re-invoke it on Ctrl+A ---
# $1 = "missing" (first-time prompt) | "rotate" (replace existing)
# returns 0 on save, 1 on cancel (rotate mode only)
prompt_and_save_key() {
  local mode="$1" new first rest
  local B=$'\033[1m' C=$'\033[36m' D=$'\033[2m' Y=$'\033[33m' G=$'\033[32m' R=$'\033[0m'
  local title rule
  if [ "$mode" = "rotate" ]; then title="Change OpenRouter API key"
  else                            title="Set OpenRouter API key"
  fi
  rule="────────────────────────────────────────────────────"

  printf "\n  %s%s %s%s\n" "$C" "🔑" "$B$title$R" >&2
  printf "  %s%s%s\n" "$D" "$rule" "$R" >&2
  if [ "$mode" = "rotate" ]; then
    printf "  %sCurrent key:%s %s  %s(will be replaced)%s\n" "$D" "$R" "$KEY_FILE" "$D" "$R" >&2
  fi
  printf "  %sGet a key at:%s %shttps://openrouter.ai/keys%s\n" "$D" "$R" "$C" "$R" >&2
  printf "  %sEsc%s cancels · %sEnter%s on empty also cancels\n\n" "$Y" "$R" "$Y" "$R" >&2
  printf "  %sKey ›%s " "$B" "$R" >&2

  # Visible input so paste works reliably and the user can verify before pressing Enter.
  IFS= read -r new || true
  new="$(printf %s "$new" | tr -d '[:space:]')"

  if [ -z "$new" ]; then
    if [ "$mode" = "rotate" ]; then
      printf "  %scancelled — key unchanged.%s\n\n" "$Y" "$R" >&2
      return 1
    fi
    printf "  %sempty key, aborting.%s\n" "$Y" "$R" >&2
    exit 1
  fi

  # Build a masked preview: first 12 chars + dots
  local preview="$(printf %s "$new" | cut -c1-12)........"

  if ! printf %s "$new" | grep -q '^sk-or-'; then
    printf "  %sKey doesn't start with 'sk-or-'.%s Confirm: %sSet API-KEY:%s %s\n" "$Y" "$R" "$B" "$R" "$preview" >&2
    printf "  Save anyway? [y/N] " >&2
    read -r CONFIRM
    case "$CONFIRM" in
      y|Y|yes|YES) ;;
      *) printf "  %saborted — key unchanged.%s\n\n" "$Y" "$R" >&2; [ "$mode" = "rotate" ] && return 1 || exit 1 ;;
    esac
  else
    printf "  Confirm: %sSet API-KEY:%s %s\n" "$B" "$R" "$preview" >&2
    printf "  Save? [Y/n] " >&2
    read -r CONFIRM
    case "$CONFIRM" in
      n|N|no|NO) printf "  %scancelled — key unchanged.%s\n\n" "$Y" "$R" >&2; [ "$mode" = "rotate" ] && return 1 || exit 1 ;;
    esac
  fi
  mkdir -p "$CONFIG_DIR"
  umask 077
  printf %s "$new" > "$KEY_FILE"
  chmod 600 "$KEY_FILE"
  KEY="$new"
  rm -f "$MODELS_CACHE" 2>/dev/null || true
  printf "  %s✓ saved%s to %s\n\n" "$G" "$R" "$KEY_FILE" >&2
  return 0
}

# --- per-launch Tavily MCP config (NOT registered at user scope) ---
# Anthropic's built-in WebSearch tool only works on its first-party endpoint, so
# it does nothing through OpenRouter. We inject Tavily as an MCP via --mcp-config
# only for claudr launches — never globally — so other `claude`
# invocations (ollama's launcher, plain `claude`, etc.) are unaffected.
# Free tier: 1000 queries/mo, no per-second cap.
# Get a key: https://app.tavily.com -> sign up -> Dashboard -> "API Keys" panel.
TAVILY_KEY_FILE="$CONFIG_DIR/tavily-key"
MCP_CONFIG_FILE="$CONFIG_DIR/mcp.json"
GLOBAL_CLEANUP_MARKER="$CONFIG_DIR/.global-mcp-cleaned.v2"
mkdir -p "$CONFIG_DIR"

# One-time: remove any user-scope Tavily registration left over from earlier
# launcher versions (which registered globally and leaked into other claude
# sessions). Runs once per machine.
cleanup_global_mcp_once() {
  [ -f "$GLOBAL_CLEANUP_MARKER" ] && return 0
  command -v claude >/dev/null 2>&1 || return 0
  for name in tavily tavily-search ddg-search brave-search; do
    claude mcp remove -s user "$name" >/dev/null 2>&1 || true
  done
  : > "$GLOBAL_CLEANUP_MARKER"
}

prompt_tavily_key() {
  # interactive only — silently skip in pipes / CI
  [ -t 0 ] && [ -t 1 ] || return 1
  local B="$(printf '\033[1m')" D="$(printf '\033[2m')" G="$(printf '\033[32m')" R="$(printf '\033[0m')"
  {
    echo ""
    printf "  %s🔎 Set up web search (Tavily)%s\n" "$B" "$R"
    printf "  %s────────────────────────────────────────────────────%s\n" "$D" "$R"
    printf "  Free tier 1000 queries/mo, AI-agent-friendly (no per-second cap).\n"
    printf "  Sign up: %shttps://app.tavily.com%s   (no card required)\n" "$D" "$R"
    printf "  Press Enter to skip (you can set it later by writing it to %s).\n\n" "$TAVILY_KEY_FILE"
    printf "  %sKey ›%s " "$B" "$R"
  } >&2
  local k=""
  IFS= read -r k || true
  k="$(printf %s "$k" | tr -d '[:space:]')"
  if [ -z "$k" ]; then
    echo "  (skipped — search registration deferred)" >&2
    return 1
  fi
  umask 077
  printf %s "$k" > "$TAVILY_KEY_FILE"
  printf "  %s✓ saved%s to %s\n\n" "$G" "$R" "$TAVILY_KEY_FILE" >&2
  return 0
}

# Write a session-scoped MCP config containing only Tavily, to be passed via
# --mcp-config. Returns 0 if a usable config exists, 1 otherwise (so the exec
# block knows whether to add the flag).
prepare_mcp_config() {
  local key="${TAVILY_API_KEY:-}"
  [ -z "$key" ] && [ -f "$TAVILY_KEY_FILE" ] && key="$(tr -d '[:space:]' < "$TAVILY_KEY_FILE")"
  if [ -z "$key" ]; then
    prompt_tavily_key || { rm -f "$MCP_CONFIG_FILE"; return 1; }
    key="$(tr -d '[:space:]' < "$TAVILY_KEY_FILE")"
  fi
  [ -z "$key" ] && { rm -f "$MCP_CONFIG_FILE"; return 1; }
  umask 077
  printf '{"mcpServers":{"tavily":{"type":"http","url":"https://mcp.tavily.com/mcp/?tavilyApiKey=%s"}}}\n' "$key" \
    > "$MCP_CONFIG_FILE"
}

cleanup_global_mcp_once
prepare_mcp_config || true

# --- key ---
KEY="${OPENROUTER_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$KEY_FILE" ]; then
  KEY="$(tr -d '[:space:]' < "$KEY_FILE")"
fi
if [ -z "$KEY" ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "claudr: no OpenRouter key found (non-interactive shell)." >&2
    echo "  set OPENROUTER_API_KEY, or write the key to: $KEY_FILE" >&2
    exit 1
  fi
  prompt_and_save_key missing
fi

# --- model aliases ---
resolve_model() {
  case "$1" in
    kimi|kimi-k2)              echo "moonshotai/kimi-k2.6" ;;
    kimi-thinking)             echo "moonshotai/kimi-k2-thinking" ;;
    sonnet)                    echo "anthropic/claude-sonnet-4.6" ;;
    opus)                      echo "anthropic/claude-opus-4.7" ;;
    haiku)                     echo "anthropic/claude-haiku-4.5" ;;
    deepseek|dsv4)             echo "deepseek/deepseek-v4-pro" ;;
    deepseek-flash)            echo "deepseek/deepseek-v4-flash" ;;
    glm|glm5)                  echo "z-ai/glm-5.1" ;;
    qwen)                      echo "qwen/qwen3.6-plus" ;;
    qwen-coder)                echo "qwen/qwen3-coder-plus" ;;
    gemma)                     echo "google/gemma-4-31b-it" ;;
    gemini)                    echo "google/gemini-2.5-pro" ;;
    minimax)                   echo "minimax/minimax-m2.7" ;;
    grok)                      echo "x-ai/grok-4.3" ;;
    gpt)                       echo "openai/gpt-5" ;;
    *)                         echo "$1" ;;
  esac
}

MODEL="${OPENROUTER_MODEL:-}"
LIST_MODE=""
RANK_VIEW="${OPENROUTER_RANK_VIEW:-week}"
TOP_N="${OPENROUTER_TOP_N:-25}"
REFRESH=0
PASSTHRU=()
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)   MODEL="$2"; shift 2 ;;
    --list)       LIST_MODE="ranked"; shift ;;
    --list-all)   LIST_MODE="all"; shift ;;
    --view)       RANK_VIEW="$2"; shift 2 ;;
    -n|--top)     TOP_N="$2"; shift 2 ;;
    --refresh)    REFRESH=1; shift ;;
    --) shift; PASSTHRU+=("$@"); break ;;
    *)  PASSTHRU+=("$1"); shift ;;
  esac
done

mkdir -p "$CONFIG_DIR"

cache_age() {
  local f="$1" mtime
  [ -f "$f" ] || { echo 999999; return; }
  mtime="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)"
  echo "$(( $(date +%s) - mtime ))"
}

# Fetch /api/v1/models JSON (6h cache).
fetch_models_json() {
  if [ "$REFRESH" -eq 0 ] && [ "$(cache_age "$MODELS_CACHE")" -lt 21600 ]; then
    cat "$MODELS_CACHE"; return
  fi
  if curl -fsSL --max-time 15 -H "Authorization: Bearer $KEY" \
       https://openrouter.ai/api/v1/models -o "$MODELS_CACHE.tmp"; then
    mv "$MODELS_CACHE.tmp" "$MODELS_CACHE"
    cat "$MODELS_CACHE"
  elif [ -f "$MODELS_CACHE" ]; then
    cat "$MODELS_CACHE"
  else
    echo "claudr: failed to fetch model catalog." >&2
    exit 1
  fi
}

# Fetch programming leaderboard, resolve permaslug -> canonical id.
# Output TSV: <id>\t<context>\t<prompt $/M>\t<name>\t<rank>
fetch_ranked_tsv() {
  local view="$1"
  # cache name carries a schema version so old caches are ignored after format changes
  local cache_view="$CONFIG_DIR/rankings.v3.$view.tsv"
  if [ "$REFRESH" -eq 0 ] && [ "$(cache_age "$cache_view")" -lt 21600 ]; then
    cat "$cache_view"; return
  fi
  local html_file="$CONFIG_DIR/rank.$view.html"
  if ! curl -fsSL --max-time 20 "https://openrouter.ai/rankings/programming?view=$view" -o "$html_file.tmp"; then
    [ -f "$cache_view" ] && { cat "$cache_view"; return; }
    echo "claudr: failed to fetch leaderboard." >&2
    exit 1
  fi
  mv "$html_file.tmp" "$html_file"
  fetch_models_json >/dev/null
  python3 - "$MODELS_CACHE" "$html_file" > "$cache_view.tmp" <<'PY'
# Reproduce the OpenRouter rankings page's own ordering:
#   - chunk #2 carries per-day {model_permaslug, total_prompt_tokens, total_completion_tokens}
#   - chunk #3 carries {slug, name} for human-readable names
#   - the page itself sums tokens per permaslug and sorts desc
#   - FALLBACK: if the page no longer embeds token data (OpenRouter switched to
#     client-side loading), build a curated picker from the catalog instead.
import json, re, sys
with open(sys.argv[1]) as f:
    catalog = json.load(f)["data"]
with open(sys.argv[2]) as f:
    html = f.read()
name_to_id = {m["name"]: m["id"] for m in catalog}
id_set = {m["id"] for m in catalog}
meta = {m["id"]: m for m in catalog}

pushes = re.findall(r'self\.__next_f\.push\(\[1,"([\s\S]*?)"\]\)', html)
all_text = "".join(json.loads('"' + p + '"') for p in pushes)

def find_obj(s, idx):
    d = 0; start = -1
    for j in range(idx, -1, -1):
        c = s[j]
        if c == '}': d += 1
        elif c == '{':
            if d == 0: start = j; break
            d -= 1
    if start < 0: return None
    dep = 0; end = -1
    for j in range(start, len(s)):
        c = s[j]
        if c == '{': dep += 1
        elif c == '}':
            dep -= 1
            if dep == 0: end = j + 1; break
    if end < 0: return None
    try: return json.loads(s[start:end])
    except Exception: return None

# permaslug -> human name (from chunk #3 entries that have request_count)
perm_to_name = {}
for m in re.finditer(r'"request_count":\d+', all_text):
    o = find_obj(all_text, m.start())
    if o and o.get("slug") and o.get("name"):
        perm_to_name[o["slug"]] = o["name"]

# sum tokens per permaslug (chunk #2 per-day rows)
tokens = {}
for m in re.finditer(r'"model_permaslug":"([^"]+)"[\s\S]{0,400}?"total_completion_tokens":(\d+)[\s\S]{0,400}?"total_prompt_tokens":(\d+)', all_text):
    perm, comp, prom = m.group(1), int(m.group(2)), int(m.group(3))
    tokens[perm] = tokens.get(perm, 0) + comp + prom

def canonical(perm):
    if perm in id_set: return perm
    nm = perm_to_name.get(perm)
    if nm and nm in name_to_id: return name_to_id[nm]
    stripped = re.sub(r'-\d{8}$|-\d{4}-\d{2}-\d{2}$|-\d{4}$|-0\d{3}$', '', perm)
    if stripped in id_set: return stripped
    return None

ranked = sorted(tokens.items(), key=lambda kv: -kv[1])
rank = 0; seen_canon = set()
for perm, tok in ranked:
    cid = canonical(perm)
    if not cid or cid in seen_canon: continue
    seen_canon.add(cid)
    rank += 1
    mm = meta[cid]
    ctx = mm.get("context_length") or 0
    pr = mm.get("pricing") or {}
    try: pm = float(pr.get("prompt", "0")) * 1_000_000
    except Exception: pm = 0.0
    try: cm = float(pr.get("completion", "0")) * 1_000_000
    except Exception: cm = 0.0
    tok_b = tok / 1_000_000_000
    desc = (mm.get("description") or "").replace("\n", " ").replace("\t", " ").strip()
    # First sentence or first 140 chars, whichever is shorter
    cut = desc.find(". ")
    if 0 < cut < 180: desc = desc[:cut+1]
    else: desc = desc[:160].rstrip() + ("…" if len(desc) > 160 else "")
    print(f"{cid}\t{ctx}\t{pm:.2f}\t{mm.get('name','')}\t{rank}\t{tok_b:.1f}B\t{desc}\t{cm:.2f}")

# ── Fallback ──
# OpenRouter now loads ranking data client-side; if the HTML scrape yields nothing,
# build a curated picker from the catalog so the user still gets a model list.
if not tokens:
    # Curated models known to work well with Claude Code through OpenRouter.
    # Order is approximate popularity / capability for coding tasks.
    curated = [
        "anthropic/claude-sonnet-4.6",
        "anthropic/claude-opus-4.7",
        "anthropic/claude-haiku-4.5",
        "moonshotai/kimi-k2.6",
        "moonshotai/kimi-k2-thinking",
        "deepseek/deepseek-v4-pro",
        "deepseek/deepseek-v4-flash",
        "openai/gpt-5",
        "google/gemini-2.5-pro",
        "google/gemma-4-31b-it",
        "qwen/qwen3.6-plus",
        "qwen/qwen3-coder-plus",
        "x-ai/grok-4.3",
        "z-ai/glm-5.1",
        "minimax/minimax-m2.7",
        "meta-llama/llama-4-scout",
    ]
    for rank, cid in enumerate(curated, start=1):
        mm = meta.get(cid)
        if not mm:
            continue
        ctx = mm.get("context_length") or 0
        pr = mm.get("pricing") or {}
        try:
            pm = float(pr.get("prompt", "0")) * 1_000_000
        except Exception:
            pm = 0.0
        try:
            cm = float(pr.get("completion", "0")) * 1_000_000
        except Exception:
            cm = 0.0
        desc = (mm.get("description") or "").replace("\n", " ").replace("\t", " ").strip()
        cut = desc.find(". ")
        if 0 < cut < 180:
            desc = desc[:cut+1]
        else:
            desc = desc[:160].rstrip() + ("…" if len(desc) > 160 else "")
        # No live token data in fallback, so tokens column shows "-"
        print(f"{cid}\t{ctx}\t{pm:.2f}\t{mm.get('name','')}\t{rank}\t-\t{desc}\t{cm:.2f}")
PY
  mv "$cache_view.tmp" "$cache_view"
  cat "$cache_view"
}

# Print all OpenRouter models as TSV (used by --list-all and by the combined picker).
# Emits the same 7-column schema as fetch_ranked_tsv so fzf_pick can consume both.
# Columns: id\tctx\tprice\tname\trank(-)\ttokens(-)\tdesc
list_all_tsv() {
  fetch_models_json >/dev/null
  python3 - "$MODELS_CACHE" <<'PY'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)["data"]
for m in sorted(data, key=lambda x: x["id"]):
    cid = m["id"]
    ctx = m.get("context_length") or 0
    pr = m.get("pricing") or {}
    try:
        pm = float(pr.get("prompt", "0")) * 1_000_000
    except Exception:
        pm = 0.0
    try:
        cm = float(pr.get("completion", "0")) * 1_000_000
    except Exception:
        cm = 0.0
    name = m.get("name", "")
    desc = (m.get("description") or "").replace("\n", " ").replace("\t", " ").strip()
    cut = desc.find(". ")
    if 0 < cut < 180:
        desc = desc[:cut+1]
    else:
        desc = desc[:160].rstrip() + ("…" if len(desc) > 160 else "")
    print(f"{cid}\t{ctx}\t{pm:.2f}\t{name}\t-\t-\t{desc}\t{cm:.2f}")
PY
}

# Build picker input: ranked top-N first, then every other catalog model.
# Lets fzf fuzzy-search the entire OpenRouter catalog while keeping the
# leaderboard ordering at the top of the list.
fetch_combined_tsv() {
  local view="$1" top_n="$2"
  local ranked_file all_file
  ranked_file="$(mktemp)"; all_file="$(mktemp)"
  fetch_ranked_tsv "$view" | head -n "$top_n" > "$ranked_file"
  list_all_tsv > "$all_file"
  cat "$ranked_file"
  awk -F'\t' 'NR==FNR{seen[$1]=1; next} !seen[$1]' "$ranked_file" "$all_file"
  rm -f "$ranked_file" "$all_file"
}

print_table() {
  awk -F'\t' '
    BEGIN { printf "%-4s %-44s %10s %10s %10s %10s  %s\n", "#", "ID", "CTX", "$/M in", "$/M out", "TOKENS", "NAME" > "/dev/stderr" }
    { printf "%-4d %-44s %10s %10s %10s %10s  %s\n", NR, $1, $2, "$"$3, "$"($8==""?"0.00":$8), ($6==""?"-":$6), $4 > "/dev/stderr" }
  '
}

# fzf-based interactive picker — full-screen, alternate-screen, wipes on exit.
# $1 = TSV file with rows: id\tctx\tprice\tname\trank\ttokens\tdesc
# Returns selected model id on stdout (or empty if cancelled).
#
# Layout: bordered full-screen panel, one row per model, side preview pane.
# Display columns are tab-separated; fzf shows column 2, returns full line so
# the caller can pull the canonical id from column 1. Column 3 holds preview
# text with literal "\n" sequences expanded by printf '%b' in --preview.
fzf_pick() {
  local tsv="$1"
  python3 - "$tsv" <<'PY' | fzf \
    --ansi \
    --reverse \
    --border=rounded \
    --border-label=' claudr · model picker ' \
    --border-label-pos=3 \
    --pointer='▶' \
    --marker=' ' \
    --prompt=' search › ' \
    --header=$'  ↑↓ navigate   ⏎ launch   ⌃A change key   esc cancel\n' \
    --header-first \
    --info=inline-right \
    --no-scrollbar \
    --margin=1,2 \
    --padding=0,1 \
    --expect=ctrl-a \
    --delimiter=$'\t' \
    --with-nth=2 \
    --preview-window='right,34%,wrap,border-left' \
    --preview-label=' details ' \
    --preview-label-pos=3 \
    --preview="printf '%b' {3}" \
    --color='border:cyan:dim,label:cyan:bold,header:dim,prompt:cyan:bold,pointer:cyan:bold,marker:cyan,bg+:-1,fg+:bright-white:bold,hl+:cyan:bold,hl:cyan,info:dim,separator:cyan:dim,preview-border:cyan:dim,preview-label:cyan:bold'
import sys
B="\033[1m"; C="\033[36m"; D="\033[2m"; Y="\033[33m"; G="\033[32m"; W="\033[97m"; R="\033[0m"
def fmt_ctx(ctx):
    try:
        n = int(ctx)
        if n >= 1_000_000:  return f"{n/1_000_000:.1f}M".replace(".0M","M")
        if n >= 1000:       return f"{n//1000}k"
        return str(n)
    except Exception:
        return ctx
with open(sys.argv[1]) as f:
    for line in f:
        parts = line.rstrip("\n").split("\t")
        while len(parts) < 8: parts.append("")
        cid, ctx, price, name, rank, tokens, desc, price_out = parts[:8]
        if not price_out: price_out = "0.00"
        ctxs = fmt_ctx(ctx)
        rank_s  = f"#{rank}" if rank and rank != "-" else ""
        price_pair = f"${price} / ${price_out}"
        # one-line row: rank · id · ctx · in/out price per million
        row = (
            f" {D}{rank_s:>4}{R}  "
            f"{C}{cid:<42}{R}  "
            f"{D}{ctxs:>5} ctx{R}   "
            f"{W}{price_pair:>17}{R} {D}/M{R}"
        )
        # preview pane (right side): name, full description, stats
        tok_line = f"\\n  {D}usage{R}    {tokens} tokens (programming rank #{rank})" if tokens and tokens != "-" else ""
        preview = (
            f"\\n  {B}{C}{cid}{R}\\n"
            f"  {D}{name}{R}\\n\\n"
            f"  {desc or '(no description)'}\\n\\n"
            f"  {D}context{R}  {ctxs}\\n"
            f"  {D}input{R}    ${price}/M tokens\\n"
            f"  {D}output{R}   ${price_out}/M tokens"
            f"{tok_line}"
        )
        # column 1: machine-readable id (used by caller)
        # column 2: shown row
        # column 3: preview text with literal \n escapes
        print(f"{cid}\t{row}\t{preview}")
PY
}

if [ -n "$LIST_MODE" ]; then
  if [ "$LIST_MODE" = "all" ]; then
    list_all_tsv | print_table
  else
    fetch_ranked_tsv "$RANK_VIEW" | head -n "$TOP_N" | print_table
    echo "" >&2
    echo "(programming leaderboard, view=$RANK_VIEW, top=$TOP_N — change with --view / -n / --refresh)" >&2
  fi
  exit 0
fi

# Interactive picker if no model specified
if [ -z "$MODEL" ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    MODEL="moonshotai/kimi-k2.6"
  else
    TMPLIST="$(mktemp)"
    fetch_combined_tsv "$RANK_VIEW" "$TOP_N" > "$TMPLIST"
    if [ ! -s "$TMPLIST" ]; then
      echo "claudr: no models available (leaderboard and catalog both empty); using moonshotai/kimi-k2.6" >&2
      MODEL="moonshotai/kimi-k2.6"
    else
      # Offer to install fzf once (~1MB, no deps); user can decline.
      if ! command -v fzf >/dev/null 2>&1 && [ ! -f "$CONFIG_DIR/.fzf-declined" ] && command -v brew >/dev/null 2>&1; then
        echo "" >&2
        echo "claudr: 'fzf' enables arrow-key model picking (recommended)." >&2
        printf "Install fzf via Homebrew now? [Y/n]: " >&2
        read -r INSTALL
        case "$INSTALL" in
          n|N|no|NO) touch "$CONFIG_DIR/.fzf-declined"; echo "  skipped (won't ask again)" >&2 ;;
          *) brew install fzf >&2 || echo "  install failed; falling back to numbered prompt" >&2 ;;
        esac
      fi

      if command -v fzf >/dev/null 2>&1; then
        while true; do
          # fzf prints the pressed --expect key on line 1, then the entry; parse both.
          PICK_OUT="$(fzf_pick "$TMPLIST")"
          PRESSED_KEY="$(printf %s "$PICK_OUT" | head -n1)"
          # column 1 of the selected row is the canonical model id
          PICK_BODY="$(printf %s "$PICK_OUT" | tail -n +2 | head -n1 | cut -f1)"
          if [ "$PRESSED_KEY" = "ctrl-a" ]; then
            if prompt_and_save_key rotate; then
              # Refresh leaderboard with the new key so cache reflects current account
              fetch_combined_tsv "$RANK_VIEW" "$TOP_N" > "$TMPLIST" || true
            fi
            continue
          fi
          MODEL="$PICK_BODY"
          break
        done
        [ -z "$MODEL" ] && { echo "claudr: cancelled." >&2; rm -f "$TMPLIST"; exit 0; }
      else
        echo "" >&2
      print_table < "$TMPLIST"
      echo "" >&2
      echo "(programming leaderboard, view=$RANK_VIEW)" >&2
      printf "Pick model [number, full slug, or empty=#1]: " >&2
      read -r CHOICE
      if [ -z "$CHOICE" ]; then
        MODEL="$(awk -F'\t' 'NR==1{print $1}' "$TMPLIST")"
      elif [[ "$CHOICE" =~ ^[0-9]+$ ]]; then
        MODEL="$(awk -F'\t' -v n="$CHOICE" 'NR==n{print $1}' "$TMPLIST")"
        [ -z "$MODEL" ] && { echo "claudr: invalid selection." >&2; exit 1; }
      else
        MODEL="$CHOICE"
      fi
      fi
    fi
    rm -f "$TMPLIST"
  fi
fi
MODEL="$(resolve_model "$MODEL")"

if ! command -v claude >/dev/null 2>&1; then
  echo "claudr: 'claude' CLI not found in PATH." >&2
  echo "  install: npm i -g @anthropic-ai/claude-code" >&2
  exit 1
fi

echo "claudr -> model=$MODEL  endpoint=https://openrouter.ai/api" >&2

export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$KEY"
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-$MODEL}"

# Claude Code limitation: when pointed at a non-Anthropic endpoint, it defaults
# the context window to a hardcoded 200K regardless of the actual model. The env
# var CLAUDE_CODE_MAX_CONTEXT_TOKENS only takes effect when DISABLE_COMPACT=1 is
# *also* set — there's no way to get both auto-compaction AND the true window.
#
# Default: disable auto-compaction, expose the real window from the catalog
# (1M for DeepSeek V4 Pro, 256K for Kimi K2.6, etc.). You can run /compact
# manually when you want it.
# Opt back to old behavior (auto-compact at 75% of a 200K cap) with
# CLAUDR_AUTOCOMPACT=1.
MODEL_CTX=200000
# Look up in the rankings TSV first (already loaded for the picker).
if [ -f "$CONFIG_DIR/rankings.v3.$RANK_VIEW.tsv" ]; then
  found_ctx="$(awk -F'\t' -v m="$MODEL" '$1==m { print $2; exit }' "$CONFIG_DIR/rankings.v3.$RANK_VIEW.tsv" 2>/dev/null || true)"
fi
# Fall back to the full /api/v1/models cache (catches models picked via -m that
# aren't in the top-N programming rankings).
if [ -z "${found_ctx:-}" ] || ! [ "$found_ctx" -gt 0 ] 2>/dev/null; then
  if [ -f "$MODELS_CACHE" ] && command -v python3 >/dev/null 2>&1; then
    found_ctx="$(python3 -c "
import json
m = '''$MODEL'''
try:
  for x in json.load(open('$MODELS_CACHE'))['data']:
    if x.get('id') == m:
      print(x.get('context_length') or 0); break
except Exception: pass
" 2>/dev/null || true)"
  fi
fi
[ -n "${found_ctx:-}" ] && [ "$found_ctx" -gt 0 ] 2>/dev/null && MODEL_CTX="$found_ctx"

if [ "${CLAUDR_AUTOCOMPACT:-0}" = "1" ]; then
  # Auto-compact mode: keep CC's 200K assumption, trigger /compact at 75%.
  export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE:-75}"
  echo "claudr: auto-compact ON (window pinned at CC's default ~200K, compact at ${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE}%)" >&2
else
  # Real-window mode: disable auto-compact so CLAUDE_CODE_MAX_CONTEXT_TOKENS applies.
  export DISABLE_COMPACT="${DISABLE_COMPACT:-1}"
  export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-$MODEL_CTX}"
  echo "claudr: context window = ${MODEL_CTX} tokens · auto-compact OFF (run /compact manually; CLAUDR_AUTOCOMPACT=1 to re-enable)" >&2
fi

# Pass --dangerously-skip-permissions by default. Opt out with CLAUDR_SAFE=1.
SKIP_PERM_FLAG="--dangerously-skip-permissions"
if [ "${CLAUDR_SAFE:-0}" = "1" ]; then SKIP_PERM_FLAG=""; fi

# Disable Anthropic's server-side WebSearch tool — it's a no-op on OpenRouter
# (Anthropic-only beta capability), and if it's visible the model picks it over
# the Tavily MCP we register. Opt out with CLAUDR_ALLOW_WEBSEARCH=1.
DISALLOW_FLAGS=()
if [ "${CLAUDR_ALLOW_WEBSEARCH:-0}" != "1" ]; then
  DISALLOW_FLAGS=(--disallowedTools WebSearch)
fi

# Inject Tavily MCP for this launch only. Other `claude` invocations on this
# machine see no Tavily, so e.g. ollama's launcher keeps its own search setup.
MCP_FLAGS=()
[ -f "$MCP_CONFIG_FILE" ] && MCP_FLAGS=(--mcp-config "$MCP_CONFIG_FILE")

exec claude ${SKIP_PERM_FLAG:+"$SKIP_PERM_FLAG"} \
  ${DISALLOW_FLAGS[@]+"${DISALLOW_FLAGS[@]}"} \
  ${MCP_FLAGS[@]+"${MCP_FLAGS[@]}"} \
  ${PASSTHRU[@]+"${PASSTHRU[@]}"}
