#!/usr/bin/env bash
# claudr — launch Claude Code routed through OpenRouter,
# with a model picker driven by OpenRouter's live programming leaderboard
# (https://openrouter.ai/rankings/programming).
#
# Usage:
#   claudr                       # launch with saved tier config (first run: setup wizard)
#   claudr --tiers [name]        # run 3-pick wizard, save as named preset (default if omitted)
#   claudr --preset <name>             # launch with a named preset (e.g. cheap, power, coding)
#   claudr --presets             # list saved presets and exit
#   claudr -m kimi               # override only the main model for this launch
#   claudr -m moonshotai/kimi-k2.6
#   claudr --solo kimi           # run every tier (opus/sonnet/haiku) on one model
#   claudr --solo                # same, but pick the one model interactively (-1 alias)
#   claudr --list                # print top N, exit
#   claudr --list -n 50          # top 50
#   claudr --view month          # ranking window: day|week|month|trending
#   claudr --refresh             # bypass 6h cache
#   claudr --doctor              # diagnose claude/fzf/key/cache health and exit
#   claudr --ask "prompt"        # non-interactive: prints just the text reply
#                                  (workaround for claude -p returning empty
#                                   result on OpenRouter endpoint)
#   claudr -- <claude args...>   # forward flags to claude
#
# Tier config (~/.config/claudr/tiers.conf) maps Claude Code's model aliases:
#   OPUS    -> ANTHROPIC_DEFAULT_OPUS_MODEL    (also the main session model)
#   SONNET  -> ANTHROPIC_DEFAULT_SONNET_MODEL  (subagent / mid-tier)
#   HAIKU   -> ANTHROPIC_DEFAULT_HAIKU_MODEL   (subagent / fast / background)
# Per-launch overrides: CLAUDR_OPUS_MODEL / CLAUDR_SONNET_MODEL / CLAUDR_HAIKU_MODEL
#
# Key resolution order:
#   1. $OPENROUTER_API_KEY env var
#   2. ~/.config/claudr/key  (chmod 600)

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claudr"
KEY_FILE="$CONFIG_DIR/key"
RANK_CACHE="$CONFIG_DIR/rankings.tsv"
MODELS_CACHE="$CONFIG_DIR/models.json"
TIERS_FILE="$CONFIG_DIR/tiers.conf"
PRESETS_DIR="$CONFIG_DIR/presets"
STATUSLINE_FILE="$CONFIG_DIR/statusline.sh"
SETTINGS_FILE="$CONFIG_DIR/settings.json"

# Render an OSC-8 terminal hyperlink: clickable in iTerm2, Windows Terminal,
# gnome-terminal, kitty, wezterm; falls back to plain text in older terminals.
hyperlink() {
  # $1 = url, $2 = display text (colored escape codes ok)
  printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$1" "$2"
}

# --- key prompt/save: factored so the picker can re-invoke it on Ctrl+A ---
# $1 = "missing" (first-time prompt) | "rotate" (replace existing)
# returns 0 on save, 1 on cancel (rotate mode only)
prompt_and_save_key() {
  local mode="$1" new first rest
  local B=$'\033[1m' C=$'\033[36m' D=$'\033[2m' Y=$'\033[33m' G=$'\033[32m' R=$'\033[0m'
  local title rule
  if [ "$mode" = "rotate" ]; then title="Change OpenRouter API key"
  else                            title="Set OpenRouter API key"
  fi
  rule="────────────────────────────────────────────────────"

  printf "\n  %s%s %s%s\n" "$C" "🔑" "$B$title$R" >&2
  printf "  %s%s%s\n" "$D" "$rule" "$R" >&2
  if [ "$mode" = "rotate" ]; then
    printf "  %sCurrent key:%s %s  %s(will be replaced)%s\n" "$D" "$R" "$KEY_FILE" "$D" "$R" >&2
  fi
  printf "  %sNew here?%s\n" "$D" "$R" >&2
  printf "  %s1.%s Sign up:    %s%s\n" "$Y" "$R" "$C" "$(hyperlink "https://openrouter.ai/sign-up" "https://openrouter.ai/sign-up")$R" >&2
  printf "  %s2.%s Create key: %s%s\n" "$Y" "$R" "$C" "$(hyperlink "https://openrouter.ai/keys" "https://openrouter.ai/keys")$R" >&2
  printf "  %s3.%s Preload a few \$ of credit, or pick a free model later (look for %s:free%s suffix)\n" "$Y" "$R" "$B" "$R" >&2
  printf "  %sAlready have a key?%s Paste it below.\n" "$D" "$R" >&2
  printf "  %sEsc%s cancels · %sEnter%s on empty also cancels\n\n" "$Y" "$R" "$Y" "$R" >&2
  printf "  %sKey ›%s " "$B" "$R" >&2

  # Visible input so paste works reliably and the user can verify before pressing Enter.
  IFS= read -r new || true
  new="$(printf %s "$new" | tr -d '[:space:]')"

  if [ -z "$new" ]; then
    if [ "$mode" = "rotate" ]; then
      printf "  %scancelled — key unchanged.%s\n\n" "$Y" "$R" >&2
      return 1
    fi
    printf "  %sempty key, aborting.%s\n" "$Y" "$R" >&2
    exit 1
  fi

  # Build a masked preview: first 12 chars + dots
  local preview="$(printf %s "$new" | cut -c1-12)........"

  if ! printf %s "$new" | grep -q '^sk-or-'; then
    printf "  %sKey doesn't start with 'sk-or-'.%s Confirm: %sSet API-KEY:%s %s\n" "$Y" "$R" "$B" "$R" "$preview" >&2
    printf "  Save anyway? [y/N] " >&2
    read -r CONFIRM
    case "$CONFIRM" in
      y|Y|yes|YES) ;;
      *) printf "  %saborted — key unchanged.%s\n\n" "$Y" "$R" >&2; [ "$mode" = "rotate" ] && return 1 || exit 1 ;;
    esac
  else
    printf "  Confirm: %sSet API-KEY:%s %s\n" "$B" "$R" "$preview" >&2
    printf "  Save? [Y/n] " >&2
    read -r CONFIRM
    case "$CONFIRM" in
      n|N|no|NO) printf "  %scancelled — key unchanged.%s\n\n" "$Y" "$R" >&2; [ "$mode" = "rotate" ] && return 1 || exit 1 ;;
    esac
  fi
  mkdir -p "$CONFIG_DIR"
  umask 077
  printf %s "$new" > "$KEY_FILE"
  chmod 600 "$KEY_FILE"
  KEY="$new"
  rm -f "$MODELS_CACHE" 2>/dev/null || true
  printf "  %s✓ saved%s to %s\n\n" "$G" "$R" "$KEY_FILE" >&2
  return 0
}

# --- per-launch Tavily MCP config (NOT registered at user scope) ---
# Anthropic's built-in WebSearch tool only works on its first-party endpoint, so
# it does nothing through OpenRouter. We inject Tavily as an MCP via --mcp-config
# only for claudr launches — never globally — so other `claude`
# invocations (ollama's launcher, plain `claude`, etc.) are unaffected.
# Free tier: 1000 queries/mo, no per-second cap.
# Get a key: https://app.tavily.com -> sign up -> Dashboard -> "API Keys" panel.
TAVILY_KEY_FILE="$CONFIG_DIR/tavily-key"
MCP_CONFIG_FILE="$CONFIG_DIR/mcp.json"
GLOBAL_CLEANUP_MARKER="$CONFIG_DIR/.global-mcp-cleaned.v2"
mkdir -p "$CONFIG_DIR"

# One-time: remove any user-scope Tavily registration left over from earlier
# launcher versions (which registered globally and leaked into other claude
# sessions). Runs once per machine.
cleanup_global_mcp_once() {
  [ -f "$GLOBAL_CLEANUP_MARKER" ] && return 0
  command -v claude >/dev/null 2>&1 || return 0
  for name in tavily tavily-search ddg-search brave-search; do
    claude mcp remove -s user "$name" >/dev/null 2>&1 || true
  done
  : > "$GLOBAL_CLEANUP_MARKER"
}

prompt_tavily_key() {
  # interactive only — silently skip in pipes / CI
  [ -t 0 ] && [ -t 1 ] || return 1
  local B="$(printf '\033[1m')" C="$(printf '\033[36m')" D="$(printf '\033[2m')" Y="$(printf '\033[33m')" G="$(printf '\033[32m')" R="$(printf '\033[0m')"
  {
    echo ""
    printf "  %s🔎 Set up web search (Tavily)%s\n" "$B" "$R"
    printf "  %s────────────────────────────────────────────────────%s\n" "$D" "$R"
    printf "  Optional — gives the model real web search through an MCP server\n"
    printf "  scoped to claudr only. %s1000 queries/month free%s, no per-second cap.\n\n" "$B" "$R"
    printf "  %sNew here?%s\n" "$D" "$R"
    printf "  %s1.%s Sign up: %s%s  %s(no credit card)%s\n" "$Y" "$R" "$C" "$(hyperlink "https://app.tavily.com" "https://app.tavily.com")$R" "$D" "$R"
    printf "  %s2.%s Copy the API key from the dashboard\n" "$Y" "$R"
    printf "  %s3.%s Paste it below\n\n" "$Y" "$R"
    printf "  %sPress Enter to skip%s (you can set it later by writing it to %s).\n\n" "$Y" "$R" "$TAVILY_KEY_FILE"
    printf "  %sKey ›%s " "$B" "$R"
  } >&2
  local k=""
  IFS= read -r k || true
  k="$(printf %s "$k" | tr -d '[:space:]')"
  if [ -z "$k" ]; then
    echo "  (skipped — search registration deferred)" >&2
    return 1
  fi
  umask 077
  printf %s "$k" > "$TAVILY_KEY_FILE"
  printf "  %s✓ saved%s to %s\n\n" "$G" "$R" "$TAVILY_KEY_FILE" >&2
  return 0
}

# Write a session-scoped MCP config containing only Tavily, to be passed via
# --mcp-config. Returns 0 if a usable config exists, 1 otherwise (so the exec
# block knows whether to add the flag).
prepare_mcp_config() {
  local key="${TAVILY_API_KEY:-}"
  [ -z "$key" ] && [ -f "$TAVILY_KEY_FILE" ] && key="$(tr -d '[:space:]' < "$TAVILY_KEY_FILE")"
  if [ -z "$key" ]; then
    prompt_tavily_key || { rm -f "$MCP_CONFIG_FILE"; return 1; }
    key="$(tr -d '[:space:]' < "$TAVILY_KEY_FILE")"
  fi
  [ -z "$key" ] && { rm -f "$MCP_CONFIG_FILE"; return 1; }
  umask 077
  printf '{"mcpServers":{"tavily":{"type":"http","url":"https://mcp.tavily.com/mcp/?tavilyApiKey=%s"}}}\n' "$key" \
    > "$MCP_CONFIG_FILE"
}

# Pre-scan args for read-only / setup modes so we can skip interactive prompts.
SKIP_INTERACTIVE_SETUP=0
for a in "$@"; do
  case "$a" in
    --doctor|--presets|--list|--list-all|-h|--help) SKIP_INTERACTIVE_SETUP=1; break ;;
  esac
done

cleanup_global_mcp_once
[ "$SKIP_INTERACTIVE_SETUP" = "1" ] || prepare_mcp_config || true

# --- key ---
KEY="${OPENROUTER_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$KEY_FILE" ]; then
  KEY="$(tr -d '[:space:]' < "$KEY_FILE")"
fi
if [ -z "$KEY" ] && [ "$SKIP_INTERACTIVE_SETUP" != "1" ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "claudr: no OpenRouter key found (non-interactive shell)." >&2
    echo "  set OPENROUTER_API_KEY, or write the key to: $KEY_FILE" >&2
    exit 1
  fi
  prompt_and_save_key missing
fi

# --- model aliases ---
resolve_model() {
  case "$1" in
    kimi|kimi-k2)              echo "moonshotai/kimi-k2.6" ;;
    kimi-thinking)             echo "moonshotai/kimi-k2-thinking" ;;
    sonnet)                    echo "anthropic/claude-sonnet-4.6" ;;
    opus)                      echo "anthropic/claude-opus-4.7" ;;
    haiku)                     echo "anthropic/claude-haiku-4.5" ;;
    deepseek|dsv4)             echo "deepseek/deepseek-v4-pro" ;;
    deepseek-flash)            echo "deepseek/deepseek-v4-flash" ;;
    glm|glm5)                  echo "z-ai/glm-5.1" ;;
    qwen)                      echo "qwen/qwen3.6-plus" ;;
    qwen-coder)                echo "qwen/qwen3-coder-plus" ;;
    gemma)                     echo "google/gemma-4-31b-it" ;;
    gemini)                    echo "google/gemini-2.5-pro" ;;
    minimax)                   echo "minimax/minimax-m2.7" ;;
    grok)                      echo "x-ai/grok-4.3" ;;
    gpt)                       echo "openai/gpt-5" ;;
    *)                         echo "$1" ;;
  esac
}

MODEL="${OPENROUTER_MODEL:-}"
LIST_MODE=""
RANK_VIEW="${OPENROUTER_RANK_VIEW:-week}"
TOP_N="${OPENROUTER_TOP_N:-25}"
REFRESH=0
TIERS_WIZARD=0
DOCTOR_MODE=0
PRESETS_LIST=0
PRESET_NAME=""
SOLO_MODE=0
SOLO_MODEL=""
WIZARD_TARGET=""
ASK_PROMPT=""
ASK_MODE=0
PASSTHRU=()
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)   MODEL="$2"; shift 2 ;;
    --tiers)
      TIERS_WIZARD=1
      # Optional preset name: --tiers <name>  (skips if next is a flag or absent)
      if [ $# -ge 2 ] && [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; then
        WIZARD_TARGET="$2"; shift 2
      else
        shift
      fi
      ;;
    --preset)    PRESET_NAME="$2"; shift 2 ;;
    --presets)   PRESETS_LIST=1; shift ;;
    --solo|-1)
      SOLO_MODE=1
      # Optional model: --solo <model>  (skips if next is a flag or absent)
      if [ $# -ge 2 ] && [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; then
        SOLO_MODEL="$2"; shift 2
      else
        shift
      fi
      ;;
    --doctor)    DOCTOR_MODE=1; shift ;;
    --ask)       ASK_MODE=1; ASK_PROMPT="$2"; shift 2 ;;
    --list)      LIST_MODE="ranked"; shift ;;
    --list-all)  LIST_MODE="all"; shift ;;
    --view)      RANK_VIEW="$2"; shift 2 ;;
    -n|--top)    TOP_N="$2"; shift 2 ;;
    --refresh)   REFRESH=1; shift ;;
    --) shift; PASSTHRU+=("$@"); break ;;
    *)  PASSTHRU+=("$1"); shift ;;
  esac
done

mkdir -p "$CONFIG_DIR"

cache_age() {
  local f="$1" mtime
  [ -f "$f" ] || { echo 999999; return; }
  mtime="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)"
  echo "$(( $(date +%s) - mtime ))"
}

# Fetch /api/v1/models JSON (6h cache).
fetch_models_json() {
  if [ "$REFRESH" -eq 0 ] && [ "$(cache_age "$MODELS_CACHE")" -lt 21600 ]; then
    cat "$MODELS_CACHE"; return
  fi
  if curl -fsSL --max-time 15 -H "Authorization: Bearer $KEY" \
       https://openrouter.ai/api/v1/models -o "$MODELS_CACHE.tmp"; then
    mv "$MODELS_CACHE.tmp" "$MODELS_CACHE"
    cat "$MODELS_CACHE"
  elif [ -f "$MODELS_CACHE" ]; then
    cat "$MODELS_CACHE"
  else
    echo "claudr: failed to fetch model catalog." >&2
    exit 1
  fi
}

# Fetch programming leaderboard, resolve permaslug -> canonical id.
# Output TSV: <id>\t<context>\t<prompt $/M>\t<name>\t<rank>
fetch_ranked_tsv() {
  local view="$1"
  # cache name carries a schema version so old caches are ignored after format changes
  local cache_view="$CONFIG_DIR/rankings.v3.$view.tsv"
  if [ "$REFRESH" -eq 0 ] && [ "$(cache_age "$cache_view")" -lt 21600 ]; then
    cat "$cache_view"; return
  fi
  local html_file="$CONFIG_DIR/rank.$view.html"
  if ! curl -fsSL --max-time 20 "https://openrouter.ai/rankings/programming?view=$view" -o "$html_file.tmp"; then
    [ -f "$cache_view" ] && { cat "$cache_view"; return; }
    echo "claudr: failed to fetch leaderboard." >&2
    exit 1
  fi
  mv "$html_file.tmp" "$html_file"
  fetch_models_json >/dev/null
  python3 - "$MODELS_CACHE" "$html_file" > "$cache_view.tmp" <<'PY'
# Reproduce the OpenRouter rankings page's own ordering:
#   - chunk #2 carries per-day {model_permaslug, total_prompt_tokens, total_completion_tokens}
#   - chunk #3 carries {slug, name} for human-readable names
#   - the page itself sums tokens per permaslug and sorts desc
#   - FALLBACK: if the page no longer embeds token data (OpenRouter switched to
#     client-side loading), build a curated picker from the catalog instead.
import json, re, sys
with open(sys.argv[1]) as f:
    catalog = json.load(f)["data"]
with open(sys.argv[2]) as f:
    html = f.read()
name_to_id = {m["name"]: m["id"] for m in catalog}
id_set = {m["id"] for m in catalog}
meta = {m["id"]: m for m in catalog}

pushes = re.findall(r'self\.__next_f\.push\(\[1,"([\s\S]*?)"\]\)', html)
all_text = "".join(json.loads('"' + p + '"') for p in pushes)

def find_obj(s, idx):
    d = 0; start = -1
    for j in range(idx, -1, -1):
        c = s[j]
        if c == '}': d += 1
        elif c == '{':
            if d == 0: start = j; break
            d -= 1
    if start < 0: return None
    dep = 0; end = -1
    for j in range(start, len(s)):
        c = s[j]
        if c == '{': dep += 1
        elif c == '}':
            dep -= 1
            if dep == 0: end = j + 1; break
    if end < 0: return None
    try: return json.loads(s[start:end])
    except Exception: return None

# permaslug -> human name (from chunk #3 entries that have request_count)
perm_to_name = {}
for m in re.finditer(r'"request_count":\d+', all_text):
    o = find_obj(all_text, m.start())
    if o and o.get("slug") and o.get("name"):
        perm_to_name[o["slug"]] = o["name"]

# sum tokens per permaslug (chunk #2 per-day rows)
tokens = {}
for m in re.finditer(r'"model_permaslug":"([^"]+)"[\s\S]{0,400}?"total_completion_tokens":(\d+)[\s\S]{0,400}?"total_prompt_tokens":(\d+)', all_text):
    perm, comp, prom = m.group(1), int(m.group(2)), int(m.group(3))
    tokens[perm] = tokens.get(perm, 0) + comp + prom

def canonical(perm):
    if perm in id_set: return perm
    nm = perm_to_name.get(perm)
    if nm and nm in name_to_id: return name_to_id[nm]
    stripped = re.sub(r'-\d{8}$|-\d{4}-\d{2}-\d{2}$|-\d{4}$|-0\d{3}$', '', perm)
    if stripped in id_set: return stripped
    return None

ranked = sorted(tokens.items(), key=lambda kv: -kv[1])
rank = 0; seen_canon = set()
for perm, tok in ranked:
    cid = canonical(perm)
    if not cid or cid in seen_canon: continue
    seen_canon.add(cid)
    rank += 1
    mm = meta[cid]
    ctx = mm.get("context_length") or 0
    pr = mm.get("pricing") or {}
    try: pm = float(pr.get("prompt", "0")) * 1_000_000
    except Exception: pm = 0.0
    try: cm = float(pr.get("completion", "0")) * 1_000_000
    except Exception: cm = 0.0
    tok_b = tok / 1_000_000_000
    desc = (mm.get("description") or "").replace("\n", " ").replace("\t", " ").strip()
    # First sentence or first 140 chars, whichever is shorter
    cut = desc.find(". ")
    if 0 < cut < 180: desc = desc[:cut+1]
    else: desc = desc[:160].rstrip() + ("…" if len(desc) > 160 else "")
    print(f"{cid}\t{ctx}\t{pm:.2f}\t{mm.get('name','')}\t{rank}\t{tok_b:.1f}B\t{desc}\t{cm:.2f}")

# ── Fallback ──
# OpenRouter now loads ranking data client-side; if the HTML scrape yields nothing,
# build a curated picker from the catalog so the user still gets a model list.
if not tokens:
    # Curated models known to work well with Claude Code through OpenRouter.
    # Order is approximate popularity / capability for coding tasks.
    curated = [
        "anthropic/claude-sonnet-4.6",
        "anthropic/claude-opus-4.7",
        "anthropic/claude-haiku-4.5",
        "moonshotai/kimi-k2.6",
        "moonshotai/kimi-k2-thinking",
        "deepseek/deepseek-v4-pro",
        "deepseek/deepseek-v4-flash",
        "openai/gpt-5",
        "google/gemini-2.5-pro",
        "google/gemma-4-31b-it",
        "qwen/qwen3.6-plus",
        "qwen/qwen3-coder-plus",
        "x-ai/grok-4.3",
        "z-ai/glm-5.1",
        "minimax/minimax-m2.7",
        "meta-llama/llama-4-scout",
    ]
    for rank, cid in enumerate(curated, start=1):
        mm = meta.get(cid)
        if not mm:
            continue
        ctx = mm.get("context_length") or 0
        pr = mm.get("pricing") or {}
        try:
            pm = float(pr.get("prompt", "0")) * 1_000_000
        except Exception:
            pm = 0.0
        try:
            cm = float(pr.get("completion", "0")) * 1_000_000
        except Exception:
            cm = 0.0
        desc = (mm.get("description") or "").replace("\n", " ").replace("\t", " ").strip()
        cut = desc.find(". ")
        if 0 < cut < 180:
            desc = desc[:cut+1]
        else:
            desc = desc[:160].rstrip() + ("…" if len(desc) > 160 else "")
        # No live token data in fallback, so tokens column shows "-"
        print(f"{cid}\t{ctx}\t{pm:.2f}\t{mm.get('name','')}\t{rank}\t-\t{desc}\t{cm:.2f}")
PY
  mv "$cache_view.tmp" "$cache_view"
  cat "$cache_view"
}

# Print all OpenRouter models as TSV (used by --list-all and by the combined picker).
# Emits the same 7-column schema as fetch_ranked_tsv so fzf_pick can consume both.
# Columns: id\tctx\tprice\tname\trank(-)\ttokens(-)\tdesc
list_all_tsv() {
  fetch_models_json >/dev/null
  python3 - "$MODELS_CACHE" <<'PY'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)["data"]
for m in sorted(data, key=lambda x: x["id"]):
    cid = m["id"]
    ctx = m.get("context_length") or 0
    pr = m.get("pricing") or {}
    try:
        pm = float(pr.get("prompt", "0")) * 1_000_000
    except Exception:
        pm = 0.0
    try:
        cm = float(pr.get("completion", "0")) * 1_000_000
    except Exception:
        cm = 0.0
    name = m.get("name", "")
    desc = (m.get("description") or "").replace("\n", " ").replace("\t", " ").strip()
    cut = desc.find(". ")
    if 0 < cut < 180:
        desc = desc[:cut+1]
    else:
        desc = desc[:160].rstrip() + ("…" if len(desc) > 160 else "")
    print(f"{cid}\t{ctx}\t{pm:.2f}\t{name}\t-\t-\t{desc}\t{cm:.2f}")
PY
}

# Build picker input: ranked top-N first, then every other catalog model.
# Lets fzf fuzzy-search the entire OpenRouter catalog while keeping the
# leaderboard ordering at the top of the list.
fetch_combined_tsv() {
  local view="$1" top_n="$2"
  local ranked_file all_file
  ranked_file="$(mktemp)"; all_file="$(mktemp)"
  fetch_ranked_tsv "$view" | head -n "$top_n" > "$ranked_file"
  list_all_tsv > "$all_file"
  cat "$ranked_file"
  awk -F'\t' 'NR==FNR{seen[$1]=1; next} !seen[$1]' "$ranked_file" "$all_file"
  rm -f "$ranked_file" "$all_file"
}

print_table() {
  awk -F'\t' '
    BEGIN { printf "%-4s %-44s %10s %10s %10s %10s  %s\n", "#", "ID", "CTX", "$/M in", "$/M out", "TOKENS", "NAME" > "/dev/stderr" }
    { printf "%-4d %-44s %10s %10s %10s %10s  %s\n", NR, $1, $2, "$"$3, "$"($8==""?"0.00":$8), ($6==""?"-":$6), $4 > "/dev/stderr" }
  '
}

# fzf-based interactive picker — full-screen, alternate-screen, wipes on exit.
# $1 = TSV file with rows: id\tctx\tprice\tname\trank\ttokens\tdesc
# $2 = tier label shown in the border, e.g. "OPUS (main)"  (optional)
# $3 = step indicator shown in the border, e.g. "1/3"      (optional)
# Returns selected model id on stdout (or empty if cancelled).
#
# Layout: bordered full-screen panel, one row per model, side preview pane.
# Display columns are tab-separated; fzf shows column 2, returns full line so
# the caller can pull the canonical id from column 1. Column 3 holds preview
# text with literal "\n" sequences expanded by printf '%b' in --preview.
# Cache fzf's help text once so we can probe which flags this build actually
# supports. More reliable than a version comparison — some distro-patched forks
# report a recent version but ship without certain options (e.g. --gutter).
_fzf_help_cached=""
fzf_has_flag() {
  # fzf_has_flag --gutter  →  0 if `fzf --help` mentions that flag, else 1
  local flag="$1"
  if [ -z "$_fzf_help_cached" ]; then
    _fzf_help_cached="$(fzf --help 2>&1 || true)"
  fi
  printf %s "$_fzf_help_cached" | grep -q -- "$flag"
}

fzf_pick() {
  local tsv="$1"
  local tier_label="${2:-model picker}"
  local step_label="${3:-}"
  local border_text
  if [ -n "$step_label" ]; then
    border_text=" claudr · $step_label · $tier_label "
  else
    border_text=" claudr · $tier_label "
  fi
  # Build the flag list incrementally — probe each modern flag against
  # `fzf --help` so distro-patched builds missing a flag don't break the picker.
  local -a fzf_opts=(
    --ansi --reverse
    --pointer='▶' --marker=' '
    --prompt=' search › '
    --header=$'  ↑↓ navigate   ⏎ confirm   ⌃A change key   esc cancel\n'
    --header-first
    --no-scrollbar
    --margin=1,2 --padding=0,1
    --expect=ctrl-a
    --delimiter=$'\t' --with-nth=2
    --preview-window='right,34%,wrap,border-left'
    --preview="printf '%b' {3}"
    --color='border:cyan:dim,label:cyan:bold,header:dim,prompt:cyan:bold,pointer:cyan:bold,marker:cyan,bg+:236,fg+:bright-white:bold,hl+:bright-cyan:bold,current-bg:236,current-fg:bright-white:bold,current-hl:bright-cyan:bold,hl:cyan,info:dim,separator:cyan:dim,preview-border:cyan:dim,preview-label:cyan:bold'
  )
  fzf_has_flag --border         && fzf_opts+=(--border=rounded)
  fzf_has_flag --border-label   && fzf_opts+=(--border-label="$border_text" --border-label-pos=3)
  fzf_has_flag --info           && fzf_opts+=(--info=inline-right)
  fzf_has_flag --highlight-line && fzf_opts+=(--highlight-line)
  fzf_has_flag --gutter         && fzf_opts+=(--gutter=' ')
  fzf_has_flag --preview-label  && fzf_opts+=(--preview-label=' details ' --preview-label-pos=3)
  python3 - "$tsv" <<'PY' | fzf "${fzf_opts[@]}"
import sys
B="\033[1m"; C="\033[36m"; D="\033[2m"; Y="\033[33m"; G="\033[32m"; W="\033[97m"; R="\033[0m"
def fmt_ctx(ctx):
    try:
        n = int(ctx)
        if n >= 1_000_000:  return f"{n/1_000_000:.1f}M".replace(".0M","M")
        if n >= 1000:       return f"{n//1000}k"
        return str(n)
    except Exception:
        return ctx
with open(sys.argv[1]) as f:
    for line in f:
        parts = line.rstrip("\n").split("\t")
        while len(parts) < 8: parts.append("")
        cid, ctx, price, name, rank, tokens, desc, price_out = parts[:8]
        if not price_out: price_out = "0.00"
        ctxs = fmt_ctx(ctx)
        rank_s  = f"#{rank}" if rank and rank != "-" else ""
        price_pair = f"${price} / ${price_out}"
        # one-line row: rank · id · ctx · in/out price per million
        row = (
            f" {D}{rank_s:>4}{R}  "
            f"{C}{cid:<42}{R}  "
            f"{D}{ctxs:>5} ctx{R}   "
            f"{W}{price_pair:>17}{R} {D}/M{R}"
        )
        # preview pane (right side): name, full description, stats
        tok_line = f"\\n  {D}usage{R}    {tokens} tokens (programming rank #{rank})" if tokens and tokens != "-" else ""
        preview = (
            f"\\n  {B}{C}{cid}{R}\\n"
            f"  {D}{name}{R}\\n\\n"
            f"  {desc or '(no description)'}\\n\\n"
            f"  {D}context{R}  {ctxs}\\n"
            f"  {D}input{R}    ${price}/M tokens\\n"
            f"  {D}output{R}   ${price_out}/M tokens"
            f"{tok_line}"
        )
        # column 1: machine-readable id (used by caller)
        # column 2: shown row
        # column 3: preview text with literal \n escapes
        print(f"{cid}\t{row}\t{preview}")
PY
}

# --- tier config: persistent opus/sonnet/haiku mapping ---
# Resolves a preset name to a config file path. Empty name → legacy tiers.conf.
preset_path() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "$TIERS_FILE"
  else
    echo "$PRESETS_DIR/${name}.conf"
  fi
}

# Loads OPUS/SONNET/HAIKU from a preset (or legacy tiers.conf if empty).
# Returns 1 if file missing or any value blank.
load_tiers() {
  local file
  file="$(preset_path "${1:-}")"
  [ -f "$file" ] || return 1
  unset OPUS SONNET HAIKU
  # shellcheck source=/dev/null
  . "$file" 2>/dev/null || return 1
  [ -n "${OPUS:-}" ] && [ -n "${SONNET:-}" ] && [ -n "${HAIKU:-}" ] || return 1
  OPUS_MODEL="$OPUS"; SONNET_MODEL="$SONNET"; HAIKU_MODEL="$HAIKU"
  return 0
}

# Writes the current OPUS_MODEL/SONNET_MODEL/HAIKU_MODEL to a preset file
# (or legacy tiers.conf if $1 empty).
save_tiers() {
  local name="${1:-}" file
  file="$(preset_path "$name")"
  mkdir -p "$(dirname "$file")"
  umask 077
  cat > "$file" <<EOF
# claudr tier config — what each Claude Code model alias resolves to.
# OPUS    = main session model + the 'opus' alias for subagents
# SONNET  = the 'sonnet' alias for subagents / mid-tier work
# HAIKU   = the 'haiku' alias for subagents / background / fast tasks
# Edit by hand, or re-run: claudr --tiers${name:+ $name}
OPUS=$OPUS_MODEL
SONNET=$SONNET_MODEL
HAIKU=$HAIKU_MODEL
EOF
}

# Prints a labeled tier block (opus/sonnet/haiku) for a preset name to stderr.
# Empty name → labels as "(default)" and loads from legacy tiers.conf.
print_preset_summary() {
  local name="$1" label="${1:-(default)}"
  local D=$'\033[2m' G=$'\033[32m' R=$'\033[0m'
  OPUS_MODEL=""; SONNET_MODEL=""; HAIKU_MODEL=""
  load_tiers "$name" >/dev/null 2>&1 || true
  printf "    %s%s%s\n" "$G" "$label" "$R" >&2
  printf "      %sopus  %s  %s\n" "$D" "$R" "$OPUS_MODEL"   >&2
  printf "      %ssonnet%s  %s\n" "$D" "$R" "$SONNET_MODEL" >&2
  printf "      %shaiku %s  %s\n" "$D" "$R" "$HAIKU_MODEL"  >&2
}

# List available presets (filename without .conf), one per line.
list_presets() {
  [ -d "$PRESETS_DIR" ] || return 0
  find "$PRESETS_DIR" -maxdepth 1 -name '*.conf' -type f 2>/dev/null \
    | sed -e 's|.*/||' -e 's|\.conf$||' \
    | sort
}

# Warns (does not fail) if any tier slug is missing from the OpenRouter catalog.
validate_tiers() {
  [ -f "$MODELS_CACHE" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  local missing
  missing="$(python3 - "$MODELS_CACHE" "$OPUS_MODEL" "$SONNET_MODEL" "$HAIKU_MODEL" <<'PY'
import json, sys
try:
    ids = {x["id"] for x in json.load(open(sys.argv[1]))["data"]}
except Exception:
    sys.exit(0)
for s in sys.argv[2:]:
    if s not in ids: print(s)
PY
)"
  if [ -n "$missing" ]; then
    local Y=$'\033[33m' R=$'\033[0m'
    echo "" >&2
    echo "  ${Y}claudr: warning${R} — tier slug(s) not in OpenRouter catalog:" >&2
    while IFS= read -r s; do echo "    · $s" >&2; done <<< "$missing"
    echo "  run: ${Y}claudr --tiers${R} to fix" >&2
    echo "" >&2
  fi
}

# Interactive 3-pick wizard. Sets OPUS_MODEL / SONNET_MODEL / HAIKU_MODEL on
# success. Returns 1 if the user pressed Esc on any pick.
run_tier_wizard() {
  command -v fzf >/dev/null 2>&1 || {
    echo "claudr: tier wizard requires fzf (install with: brew install fzf)." >&2
    return 1
  }
  local tmplist
  tmplist="$(mktemp)"
  fetch_combined_tsv "$RANK_VIEW" "$TOP_N" > "$tmplist"
  if [ ! -s "$tmplist" ]; then
    rm -f "$tmplist"
    echo "claudr: no models available — leaderboard and catalog both empty." >&2
    return 1
  fi
  local tiers=("OPUS (main)" "SONNET" "HAIKU")
  local picks=()
  local i=0
  while [ $i -lt 3 ]; do
    local label="${tiers[$i]}"
    local step="$((i+1))/3"
    while true; do
      local out pressed body
      out="$(fzf_pick "$tmplist" "$label" "$step")"
      pressed="$(printf %s "$out" | head -n1)"
      body="$(printf %s "$out" | tail -n +2 | head -n1 | cut -f1)"
      if [ "$pressed" = "ctrl-a" ]; then
        if prompt_and_save_key rotate; then
          fetch_combined_tsv "$RANK_VIEW" "$TOP_N" > "$tmplist" || true
        fi
        continue
      fi
      if [ -z "$body" ]; then
        rm -f "$tmplist"
        return 1
      fi
      picks+=("$body")
      break
    done
    i=$((i+1))
  done
  rm -f "$tmplist"
  OPUS_MODEL="${picks[0]}"
  SONNET_MODEL="${picks[1]}"
  HAIKU_MODEL="${picks[2]}"
  return 0
}

# --presets — list saved presets and exit
if [ "$PRESETS_LIST" = "1" ]; then
  B=$'\033[1m'; C=$'\033[36m'; D=$'\033[2m'; G=$'\033[32m'; R=$'\033[0m'
  echo "" >&2
  printf "  %s%sclaudr presets%s\n" "$B" "$C" "$R" >&2
  printf "  %s──────────────────────────────────────────────────%s\n" "$D" "$R" >&2
  found=0
  if [ -f "$TIERS_FILE" ]; then
    found=1; print_preset_summary ""
  fi
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    found=1; print_preset_summary "$name"
  done < <(list_presets)
  [ "$found" = "0" ] && printf "    %sno presets saved — run: claudr --tiers <name>%s\n" "$D" "$R" >&2
  echo "" >&2
  printf "  %slaunch with: claudr --preset <name>%s\n\n" "$D" "$R" >&2
  exit 0
fi

# --tiers [name] — reconfigure tiers (optionally as named preset) and exit
if [ "$TIERS_WIZARD" = "1" ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "claudr --tiers requires an interactive terminal." >&2
    exit 1
  fi
  if run_tier_wizard; then
    save_tiers "$WIZARD_TARGET"
    saved_to="$(preset_path "$WIZARD_TARGET")"
    G=$'\033[32m'; D=$'\033[2m'; R=$'\033[0m'
    echo "" >&2
    if [ -n "$WIZARD_TARGET" ]; then
      echo "  ${G}✓${R} preset '${WIZARD_TARGET}' saved to $saved_to" >&2
      echo "    launch with: claudr --preset $WIZARD_TARGET" >&2
    else
      echo "  ${G}✓${R} tier config saved to $saved_to" >&2
    fi
    printf "    %sopus  %s  %s\n" "$D" "$R" "$OPUS_MODEL"   >&2
    printf "    %ssonnet%s  %s\n" "$D" "$R" "$SONNET_MODEL" >&2
    printf "    %shaiku %s  %s\n" "$D" "$R" "$HAIKU_MODEL"  >&2
    echo "" >&2
    exit 0
  else
    echo "claudr: cancelled — no changes saved." >&2
    exit 1
  fi
fi

# --doctor — health check and exit
if [ "$DOCTOR_MODE" = "1" ]; then
  B=$'\033[1m'; C=$'\033[36m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; RED=$'\033[31m'; R=$'\033[0m'
  PASS="${G}✓${R}"; WARN="${Y}!${R}"; FAIL="${RED}✗${R}"
  fails=0; warns=0
  doctor_row() { printf "    %s %-18s %s%s%s\n" "$1" "$2" "$D" "$3" "$R" >&2; }

  echo "" >&2
  printf "  %s%sclaudr · doctor%s\n" "$B" "$C" "$R" >&2
  printf "  %s──────────────────────────────────────────────────%s\n" "$D" "$R" >&2

  if command -v claude >/dev/null 2>&1; then
    doctor_row "$PASS" "claude CLI" "$(claude --version 2>/dev/null | head -n1)"
  else
    doctor_row "$FAIL" "claude CLI" "not in PATH — npm i -g @anthropic-ai/claude-code"
    fails=$((fails+1))
  fi

  if command -v fzf >/dev/null 2>&1; then
    doctor_row "$PASS" "fzf" "$(fzf --version 2>/dev/null | awk '{print $1}')"
  else
    doctor_row "$FAIL" "fzf" "missing — brew install fzf"
    fails=$((fails+1))
  fi

  if command -v python3 >/dev/null 2>&1; then
    doctor_row "$PASS" "python3" "$(python3 --version 2>/dev/null | awk '{print $2}')"
  else
    doctor_row "$FAIL" "python3" "missing — required for catalog parsing"
    fails=$((fails+1))
  fi

  if [ -z "${KEY:-}" ]; then
    doctor_row "$FAIL" "OpenRouter key" "not configured"
    fails=$((fails+1))
  else
    src="env"; [ -z "${OPENROUTER_API_KEY:-}" ] && src="$KEY_FILE"
    http_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 \
      -H "Authorization: Bearer $KEY" https://openrouter.ai/api/v1/auth/key 2>/dev/null || echo 000)"
    case "$http_code" in
      200)     doctor_row "$PASS" "OpenRouter key" "valid (from $src)" ;;
      401|403) doctor_row "$FAIL" "OpenRouter key" "rejected (HTTP $http_code)"; fails=$((fails+1)) ;;
      *)       doctor_row "$WARN" "OpenRouter key" "could not verify (HTTP $http_code)"; warns=$((warns+1)) ;;
    esac
  fi

  if [ -n "${TAVILY_API_KEY:-}" ] || [ -f "$TAVILY_KEY_FILE" ]; then
    doctor_row "$PASS" "Tavily key" "configured (web search enabled)"
  else
    doctor_row "$WARN" "Tavily key" "not set — web search disabled"
    warns=$((warns+1))
  fi

  if load_tiers ""; then
    doctor_row "$PASS" "default tiers" "opus=$OPUS_MODEL sonnet=$SONNET_MODEL haiku=$HAIKU_MODEL"
  else
    doctor_row "$WARN" "default tiers" "none — first launch will run setup wizard"
    warns=$((warns+1))
  fi

  if [ -f "$MODELS_CACHE" ] && [ -n "${OPUS_MODEL:-}" ]; then
    missing="$(python3 - "$MODELS_CACHE" "$OPUS_MODEL" "$SONNET_MODEL" "$HAIKU_MODEL" <<'PY' 2>/dev/null
import json, sys
try: ids = {x["id"] for x in json.load(open(sys.argv[1]))["data"]}
except Exception: sys.exit(0)
for s in sys.argv[2:]:
    if s not in ids: print(s)
PY
)"
    if [ -z "$missing" ]; then
      doctor_row "$PASS" "tier slugs" "all resolve in OpenRouter catalog"
    else
      doctor_row "$WARN" "tier slugs" "unknown: $(echo "$missing" | tr '\n' ' ')"
      warns=$((warns+1))
    fi
  fi

  p_count="$(list_presets | wc -l | tr -d ' ')"
  if [ "${p_count:-0}" -gt 0 ]; then
    doctor_row "$PASS" "presets" "$p_count saved ($(list_presets | tr '\n' ' '))"
  else
    doctor_row "$WARN" "presets" "none — create with: claudr --tiers <name>"
  fi

  if [ -f "$MODELS_CACHE" ]; then
    age=$(cache_age "$MODELS_CACHE"); h=$((age/3600))
    if [ "$age" -lt 21600 ]; then
      doctor_row "$PASS" "models cache" "${h}h old (fresh)"
    else
      doctor_row "$WARN" "models cache" "${h}h old (stale — run: claudr --refresh)"
      warns=$((warns+1))
    fi
  else
    doctor_row "$WARN" "models cache" "not yet fetched"
  fi

  echo "" >&2
  if [ "$fails" -gt 0 ]; then
    printf "  %s%d failed, %d warnings%s\n\n" "$RED" "$fails" "$warns" "$R" >&2
    exit 1
  elif [ "$warns" -gt 0 ]; then
    printf "  %sall critical checks passed, %d warnings%s\n\n" "$Y" "$warns" "$R" >&2
  else
    printf "  %sall checks passed%s\n\n" "$G" "$R" >&2
  fi
  exit 0
fi

if [ -n "$LIST_MODE" ]; then
  if [ "$LIST_MODE" = "all" ]; then
    list_all_tsv | print_table
  else
    fetch_ranked_tsv "$RANK_VIEW" | head -n "$TOP_N" | print_table
    echo "" >&2
    echo "(programming leaderboard, view=$RANK_VIEW, top=$TOP_N — change with --view / -n / --refresh)" >&2
  fi
  exit 0
fi

# --- tier resolution ---
# Resolution: env var > preset (-p) > tiers.conf > first-launch wizard > -m fanout > fallback
OPUS_MODEL=""; SONNET_MODEL=""; HAIKU_MODEL=""
ACTIVE_PRESET=""
if [ "$SOLO_MODE" = "1" ]; then
  # --solo: run every tier on a single model. No preset, no wizard, no fanout
  # subtleties — opus/sonnet/haiku and the main session all point at one slug.
  # Source order: --solo <model> > -m <model> > interactive pick > fallback.
  solo_pick="$SOLO_MODEL"
  [ -z "$solo_pick" ] && solo_pick="$MODEL"
  if [ -z "$solo_pick" ] && [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1; then
    tmplist="$(mktemp)"
    fetch_combined_tsv "$RANK_VIEW" "$TOP_N" > "$tmplist" || true
    if [ -s "$tmplist" ]; then
      solo_out="$(fzf_pick "$tmplist" "SOLO (all tiers)")"
      solo_pick="$(printf %s "$solo_out" | tail -n +2 | head -n1 | cut -f1)"
    fi
    rm -f "$tmplist"
    [ -z "$solo_pick" ] && { echo "claudr: solo selection cancelled." >&2; exit 1; }
  fi
  [ -z "$solo_pick" ] && solo_pick="moonshotai/kimi-k2.6"  # non-interactive fallback
  solo_pick="$(resolve_model "$solo_pick")"
  OPUS_MODEL="$solo_pick"; SONNET_MODEL="$solo_pick"; HAIKU_MODEL="$solo_pick"
  MODEL="$solo_pick"
elif [ -n "$PRESET_NAME" ]; then
  if load_tiers "$PRESET_NAME"; then
    ACTIVE_PRESET="$PRESET_NAME"
  else
    echo "claudr: preset '$PRESET_NAME' not found at $(preset_path "$PRESET_NAME")" >&2
    echo "  list presets: claudr --presets" >&2
    echo "  create one:   claudr --tiers $PRESET_NAME" >&2
    exit 1
  fi
else
  load_tiers "" || true   # legacy default; leaves vars blank if missing
fi

# Per-launch env overrides (highest precedence). Skipped under --solo, which is
# an explicit "one model everywhere" request that should beat per-tier env vars.
if [ "$SOLO_MODE" != "1" ]; then
  [ -n "${CLAUDR_OPUS_MODEL:-}" ]   && OPUS_MODEL="$CLAUDR_OPUS_MODEL"
  [ -n "${CLAUDR_SONNET_MODEL:-}" ] && SONNET_MODEL="$CLAUDR_SONNET_MODEL"
  [ -n "${CLAUDR_HAIKU_MODEL:-}" ]  && HAIKU_MODEL="$CLAUDR_HAIKU_MODEL"
fi

# Still missing any tier? Either run the wizard (interactive), fan out -m, or fall back.
if [ -z "$OPUS_MODEL" ] || [ -z "$SONNET_MODEL" ] || [ -z "$HAIKU_MODEL" ]; then
  if [ -n "$MODEL" ]; then
    # -m given without saved config: use the slug for every tier.
    fanout="$(resolve_model "$MODEL")"
    [ -z "$OPUS_MODEL" ]   && OPUS_MODEL="$fanout"
    [ -z "$SONNET_MODEL" ] && SONNET_MODEL="$fanout"
    [ -z "$HAIKU_MODEL" ]  && HAIKU_MODEL="$fanout"
  elif [ -t 0 ] && [ -t 1 ]; then
    # Offer to install fzf once if missing.
    if ! command -v fzf >/dev/null 2>&1 && [ ! -f "$CONFIG_DIR/.fzf-declined" ] && command -v brew >/dev/null 2>&1; then
      echo "" >&2
      echo "claudr: 'fzf' is required for the tier picker." >&2
      printf "Install fzf via Homebrew now? [Y/n]: " >&2
      read -r INSTALL
      case "$INSTALL" in
        n|N|no|NO) touch "$CONFIG_DIR/.fzf-declined"; echo "  declined — claudr needs fzf to configure tiers." >&2; exit 1 ;;
        *) brew install fzf >&2 || { echo "  install failed." >&2; exit 1; } ;;
      esac
    fi
    B=$'\033[1m'; C=$'\033[36m'; D=$'\033[2m'; R=$'\033[0m'
    echo "" >&2
    echo "  ${B}${C}claudr · first-run tier setup${R}" >&2
    echo "  ${D}Pick three OpenRouter models. Opus becomes your main; Sonnet and Haiku${R}" >&2
    echo "  ${D}fill in when Claude Code dispatches subagents at those tiers.${R}" >&2
    echo "" >&2
    if run_tier_wizard; then
      save_tiers
    else
      echo "claudr: setup cancelled." >&2
      exit 1
    fi
  else
    # Non-interactive, no config, no -m → safe default fanout.
    fallback="moonshotai/kimi-k2.6"
    [ -z "$OPUS_MODEL" ]   && OPUS_MODEL="$fallback"
    [ -z "$SONNET_MODEL" ] && SONNET_MODEL="$fallback"
    [ -z "$HAIKU_MODEL" ]  && HAIKU_MODEL="$fallback"
  fi
fi

# Resolve aliases ("kimi" → "moonshotai/kimi-k2.6" etc.) on every tier slug.
OPUS_MODEL="$(resolve_model "$OPUS_MODEL")"
SONNET_MODEL="$(resolve_model "$SONNET_MODEL")"
HAIKU_MODEL="$(resolve_model "$HAIKU_MODEL")"

# -m overrides main model only; tier mapping is untouched. With no -m, main = opus.
if [ -n "$MODEL" ]; then
  MODEL="$(resolve_model "$MODEL")"
else
  MODEL="$OPUS_MODEL"
fi

validate_tiers

if ! command -v claude >/dev/null 2>&1; then
  echo "claudr: 'claude' CLI not found in PATH." >&2
  echo "  install: npm i -g @anthropic-ai/claude-code" >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$KEY"
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$OPUS_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$SONNET_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$HAIKU_MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-$HAIKU_MODEL}"

# OpenRouter attribution headers — claudr identifies itself in your
# https://openrouter.ai/activity dashboard. Overridable for users who want
# their own X-Title/HTTP-Referer.
CLAUDR_REFERER="${CLAUDR_REFERER:-https://github.com/olindkri/claudr}"
CLAUDR_TITLE="${CLAUDR_TITLE:-claudr}"
export ANTHROPIC_CUSTOM_HEADERS="HTTP-Referer: $CLAUDR_REFERER
X-Title: $CLAUDR_TITLE"

# Claude Code limitation: when pointed at a non-Anthropic endpoint, it defaults
# the context window to a hardcoded 200K regardless of the actual model. The env
# var CLAUDE_CODE_MAX_CONTEXT_TOKENS only takes effect when DISABLE_COMPACT=1 is
# *also* set — there's no way to get both auto-compaction AND the true window.
#
# Default: disable auto-compaction, expose the real window from the catalog
# (1M for DeepSeek V4 Pro, 256K for Kimi K2.6, etc.). You can run /compact
# manually when you want it.
# Opt back to old behavior (auto-compact at 75% of a 200K cap) with
# CLAUDR_AUTOCOMPACT=1.
MODEL_CTX=200000
# Look up in the rankings TSV first (already loaded for the picker).
if [ -f "$CONFIG_DIR/rankings.v3.$RANK_VIEW.tsv" ]; then
  found_ctx="$(awk -F'\t' -v m="$MODEL" '$1==m { print $2; exit }' "$CONFIG_DIR/rankings.v3.$RANK_VIEW.tsv" 2>/dev/null || true)"
fi
# Fall back to the full /api/v1/models cache (catches models picked via -m that
# aren't in the top-N programming rankings).
if [ -z "${found_ctx:-}" ] || ! [ "$found_ctx" -gt 0 ] 2>/dev/null; then
  if [ -f "$MODELS_CACHE" ] && command -v python3 >/dev/null 2>&1; then
    found_ctx="$(python3 -c "
import json
m = '''$MODEL'''
try:
  for x in json.load(open('$MODELS_CACHE'))['data']:
    if x.get('id') == m:
      print(x.get('context_length') or 0); break
except Exception: pass
" 2>/dev/null || true)"
  fi
fi
[ -n "${found_ctx:-}" ] && [ "$found_ctx" -gt 0 ] 2>/dev/null && MODEL_CTX="$found_ctx"

if [ "${CLAUDR_AUTOCOMPACT:-0}" = "1" ]; then
  # Auto-compact mode: keep CC's 200K assumption, trigger /compact at 75%.
  export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE:-75}"
  COMPACT_STATE="on @ ${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE}% (200K cap)"
else
  # Real-window mode: disable auto-compact so CLAUDE_CODE_MAX_CONTEXT_TOKENS applies.
  export DISABLE_COMPACT="${DISABLE_COMPACT:-1}"
  export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-$MODEL_CTX}"
  COMPACT_STATE="off · run /compact manually"
fi

# Pass --dangerously-skip-permissions by default. Opt out with CLAUDR_SAFE=1.
SKIP_PERM_FLAG="--dangerously-skip-permissions"
if [ "${CLAUDR_SAFE:-0}" = "1" ]; then SKIP_PERM_FLAG=""; fi

# Disable Anthropic's server-side WebSearch tool — it's a no-op on OpenRouter
# (Anthropic-only beta capability), and if it's visible the model picks it over
# the Tavily MCP we register. Opt out with CLAUDR_ALLOW_WEBSEARCH=1.
#
# Also disable WebFetch when Tavily is configured: WebFetch makes an internal
# "small fast model" summarization call that needs Anthropic response shape;
# on non-Anthropic HAIKU tiers it fails silently with "No response from model".
# tavily_extract (already exposed by the Tavily MCP) does the same job and
# works reliably. Opt out with CLAUDR_ALLOW_WEBFETCH=1.
DISALLOW_FLAGS=()
disallow_tools=()
if [ "${CLAUDR_ALLOW_WEBSEARCH:-0}" != "1" ]; then
  disallow_tools+=(WebSearch)
fi
if [ -f "$MCP_CONFIG_FILE" ] && [ "${CLAUDR_ALLOW_WEBFETCH:-0}" != "1" ]; then
  disallow_tools+=(WebFetch)
fi
if [ ${#disallow_tools[@]} -gt 0 ]; then
  DISALLOW_FLAGS=(--disallowedTools "${disallow_tools[@]}")
fi

# Inject Tavily MCP for this launch only. Other `claude` invocations on this
# machine see no Tavily, so e.g. ollama's launcher keeps its own search setup.
MCP_FLAGS=()
[ -f "$MCP_CONFIG_FILE" ] && MCP_FLAGS=(--mcp-config "$MCP_CONFIG_FILE")

# Compute human-readable context window early (statusline + banner both use it).
if [ "$MODEL_CTX" -ge 1000000 ] 2>/dev/null; then
  CTX_HUMAN="$(awk -v x="$MODEL_CTX" 'BEGIN{v=x/1000000; if (v==int(v)) printf "%dM", v; else printf "%.1fM", v}')"
elif [ "$MODEL_CTX" -ge 1000 ] 2>/dev/null; then
  CTX_HUMAN="$(( MODEL_CTX / 1000 ))k"
else
  CTX_HUMAN="$MODEL_CTX"
fi

# Single pass over PASSTHRU: detect -p / --print / --output-format, capture the
# prompt that follows -p, and build a FILTERED copy with -p and its arg stripped
# (used when we auto-route through --ask).
PRINT_MODE=0; HAS_OUTPUT_FORMAT=0; PRINT_PROMPT=""
FILTERED=(); prev=""
for a in ${PASSTHRU[@]+"${PASSTHRU[@]}"}; do
  case "$a" in
    -p|--print)      PRINT_MODE=1; prev="$a" ;;
    --output-format) HAS_OUTPUT_FORMAT=1; prev=""; FILTERED+=("$a") ;;
    *)
      if [ "$prev" = "-p" ] || [ "$prev" = "--print" ]; then
        PRINT_PROMPT="$a"
      else
        FILTERED+=("$a")
      fi
      prev="" ;;
  esac
done

# Auto-route `claudr -p "prompt"` (no --output-format) through --ask to work
# around claude-code#38805: text block is dropped from `result` when responses
# include trailing redacted_thinking blocks. Opt out with CLAUDR_RAW_PRINT=1.
if [ "$PRINT_MODE" = "1" ] && [ "$HAS_OUTPUT_FORMAT" = "0" ] \
   && [ "$ASK_MODE" = "0" ] && [ -n "$PRINT_PROMPT" ] \
   && [ "${CLAUDR_RAW_PRINT:-0}" != "1" ]; then
  ASK_MODE=1
  ASK_PROMPT="$PRINT_PROMPT"
  PASSTHRU=("${FILTERED[@]+${FILTERED[@]}}")
fi

# MAX_THINKING_TOKENS=0 stops Claude Code requesting extended thinking, so the
# response has no redacted_thinking blocks → result extractor works on direct
# `claude -p` against Anthropic models (helps the CLAUDR_RAW_PRINT=1 path).
# Interactive sessions keep thinking. Force with CLAUDR_THINKING=1.
if { [ "$PRINT_MODE" = "1" ] || [ "$ASK_MODE" = "1" ]; } && [ "${CLAUDR_THINKING:-0}" != "1" ]; then
  export MAX_THINKING_TOKENS="${MAX_THINKING_TOKENS:-0}"
fi

# Banner is noise in scripted output: suppress in print/ask mode or when stderr
# isn't a TTY. Force-show with CLAUDR_BANNER=1.
SHOW_BANNER=1
if [ "${CLAUDR_BANNER:-0}" != "1" ] \
   && { [ "$PRINT_MODE" = "1" ] || [ "$ASK_MODE" = "1" ] || [ ! -t 2 ]; }; then
  SHOW_BANNER=0
fi

# --- statusline: show current OpenRouter model in Claude Code's footer ---
# Generates a tiny script that Claude Code calls on each status refresh.
# Receives a JSON blob on stdin; we mostly use environment for speed.
# Opt out with CLAUDR_STATUSLINE=0.
SETTINGS_FLAGS=()
if [ "${CLAUDR_STATUSLINE:-1}" = "1" ]; then
  umask 077
  # Statusline + settings.json contents are static — only rewrite if missing.
  if [ ! -f "$STATUSLINE_FILE" ] || [ ! -f "$SETTINGS_FILE" ]; then
  cat > "$STATUSLINE_FILE" <<'STATUSLINE'
#!/usr/bin/env bash
# claudr statusline — invoked by Claude Code; receives session JSON on stdin.
# Renders: claudr · <model> · ctx <X>k · <cwd>
set -eu
input="$(cat)"
model="${ANTHROPIC_MODEL:-?}"
ctx="${CLAUDR_CTX_HUMAN:-?}"
preset="${CLAUDR_ACTIVE_PRESET:-}"
# Try to pull cwd from the JSON without requiring jq.
cwd="$(printf %s "$input" | sed -n 's/.*"current_working_directory"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
[ -z "$cwd" ] && cwd="$(pwd)"
short_cwd="${cwd##*/}"
C=$'\033[36m'; D=$'\033[2m'; B=$'\033[1m'; R=$'\033[0m'
if [ -n "$preset" ]; then
  printf "%sclaudr%s %s·%s %s%s%s %s·%s ctx %s %s·%s %s[%s]%s %s·%s %s%s%s" \
    "$C" "$R" "$D" "$R" "$B" "$model" "$R" "$D" "$R" "$ctx" "$D" "$R" "$C" "$preset" "$R" "$D" "$R" "$D" "$short_cwd" "$R"
else
  printf "%sclaudr%s %s·%s %s%s%s %s·%s ctx %s %s·%s %s%s%s" \
    "$C" "$R" "$D" "$R" "$B" "$model" "$R" "$D" "$R" "$ctx" "$D" "$R" "$D" "$short_cwd" "$R"
fi
STATUSLINE
  chmod +x "$STATUSLINE_FILE"
  # Write a session settings.json wiring the statusline.
  cat > "$SETTINGS_FILE" <<JSON
{
  "statusLine": {
    "type": "command",
    "command": "$STATUSLINE_FILE",
    "padding": 0
  }
}
JSON
  fi
  SETTINGS_FLAGS=(--settings "$SETTINGS_FILE")
  export CLAUDR_CTX_HUMAN="$CTX_HUMAN"
  export CLAUDR_ACTIVE_PRESET="$ACTIVE_PRESET"
fi

# --- unified launch banner ---
# Show endpoint, tier mapping, and all non-default behaviors in one card so the
# user can see at a glance what mode claudr is in. Rendered to stderr so it
# never pollutes piped output.
if [ "$SHOW_BANNER" = "1" ]; then
{
  B=$'\033[1m'; C=$'\033[36m'; D=$'\033[2m'; Y=$'\033[33m'; G=$'\033[32m'; M=$'\033[35m'; R=$'\033[0m'

  # state strings
  if [ -n "$SKIP_PERM_FLAG" ]; then PERMS="${Y}bypassed${R}  ${D}CLAUDR_SAFE=1 to enable${R}"
  else                              PERMS="${G}prompted${R}"
  fi
  disabled_list="${disallow_tools[*]:-}"
  if [ -f "$MCP_CONFIG_FILE" ] && [ -n "$disabled_list" ]; then
    WEBSEARCH="${G}Tavily MCP${R}  ${D}(disabled: ${disabled_list// /, })${R}"
  elif [ -f "$MCP_CONFIG_FILE" ]; then
    WEBSEARCH="${G}Tavily MCP${R}"
  elif [ -n "$disabled_list" ]; then
    WEBSEARCH="${D}none  (disabled: ${disabled_list// /, })${R}"
  else
    WEBSEARCH="${D}none${R}"
  fi

  # mark "main = opus" so users see the alias relationship; in --solo mode all
  # three tiers are the same slug, so call that out instead.
  if [ "$SOLO_MODE" = "1" ]; then          MAIN_NOTE="${D} = solo (all tiers)${R}"
  elif [ "$MODEL" = "$OPUS_MODEL" ]; then  MAIN_NOTE="${D} = opus${R}"
  else                                     MAIN_NOTE=""
  fi

  echo ""
  printf "  %s%sclaudr%s  %s· OpenRouter routing for Claude Code%s\n" "$B" "$C" "$R" "$D" "$R"
  printf "  %s──────────────────────────────────────────────────%s\n" "$D" "$R"
  printf "    %sendpoint%s   %s\n" "$D" "$R" "https://openrouter.ai/api"
  echo ""
  printf "    %smain%s       %s%s%s%s\n"     "$C" "$R" "$B" "$MODEL"        "$R" "$MAIN_NOTE"
  printf "    %ssonnet%s     %s\n"           "$D" "$R" "$SONNET_MODEL"
  printf "    %shaiku%s      %s\n"           "$D" "$R" "$HAIKU_MODEL"
  echo ""
  printf "    %scontext%s    %s%s%s tokens  %s(%s)%s\n" "$D" "$R" "$B" "$CTX_HUMAN" "$R" "$D" "$MODEL_CTX" "$R"
  printf "    %scompact%s    %s\n"           "$D" "$R" "$COMPACT_STATE"
  printf "    %ssearch%s     %b\n"           "$D" "$R" "$WEBSEARCH"
  printf "    %sperms%s      %b\n"           "$D" "$R" "$PERMS"
  echo ""
  if [ -n "$ACTIVE_PRESET" ]; then
    printf "    %spreset%s %s%s%s · %sclaudr --tiers%s to reconfigure · %sCLAUDR_AUTOCOMPACT=1 CLAUDR_SAFE=1 CLAUDR_ALLOW_WEBSEARCH=1%s\n" "$D" "$R" "$C" "$ACTIVE_PRESET" "$R" "$D" "$R" "$D" "$R"
  else
    printf "    %sclaudr --tiers%s to reconfigure · %sCLAUDR_AUTOCOMPACT=1 CLAUDR_SAFE=1 CLAUDR_ALLOW_WEBSEARCH=1%s\n" "$D" "$R" "$D" "$R"
  fi
  echo ""
} >&2
fi

# --ask: workaround for claude -p returning empty `result` when ANTHROPIC_BASE_URL
# is OpenRouter. The model responds correctly in the stream; only the final
# text-mode result extraction is broken. Stream the response, parse out text
# blocks ourselves, and emit just the assistant's reply on stdout.
if [ "$ASK_MODE" = "1" ]; then
  if [ -z "$ASK_PROMPT" ]; then
    echo "claudr --ask requires a prompt: claudr --ask \"your prompt\"" >&2
    exit 1
  fi
  claude ${SKIP_PERM_FLAG:+"$SKIP_PERM_FLAG"} \
    ${DISALLOW_FLAGS[@]+"${DISALLOW_FLAGS[@]}"} \
    ${MCP_FLAGS[@]+"${MCP_FLAGS[@]}"} \
    ${SETTINGS_FLAGS[@]+"${SETTINGS_FLAGS[@]}"} \
    ${PASSTHRU[@]+"${PASSTHRU[@]}"} \
    -p "$ASK_PROMPT" --output-format stream-json --verbose 2>/dev/null \
    | python3 -c '
import json, sys
exit_code = 0
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try: obj = json.loads(line)
    except Exception: continue
    if obj.get("type") == "assistant":
        for block in obj.get("message", {}).get("content", []) or []:
            if block.get("type") == "text":
                sys.stdout.write(block.get("text", ""))
        sys.stdout.flush()
    elif obj.get("type") == "result" and obj.get("is_error"):
        msg = obj.get("result") or "error"
        sys.stderr.write("claudr --ask: " + str(msg) + "\n")
        exit_code = 1
sys.stdout.write("\n")
sys.exit(exit_code)
'
  exit $?
fi

exec claude ${SKIP_PERM_FLAG:+"$SKIP_PERM_FLAG"} \
  ${DISALLOW_FLAGS[@]+"${DISALLOW_FLAGS[@]}"} \
  ${MCP_FLAGS[@]+"${MCP_FLAGS[@]}"} \
  ${SETTINGS_FLAGS[@]+"${SETTINGS_FLAGS[@]}"} \
  ${PASSTHRU[@]+"${PASSTHRU[@]}"}
